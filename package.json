{
  "name": "composable-cow-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "pnpm npm-run-all -l --parallel dev:**",
    "build": "pnpm npm-run-all -l --parallel build:**",
    "dev:docs": "vocs dev",
    "build:docs": "vocs build",
    "preview:docs": "vocs preview",
    "dev:next": "pnpm prepare:catalog && pnpm check:assets && pnpm check:catalog && next dev",
    "build:next": "pnpm prepare:catalog && pnpm check:assets && pnpm check:catalog && next build",
    "start:next": "next start",
    "check:next": "prettier --check \"**/*.{md,html,mjml,json,yml,css,scss}\"",
    "prepare:assets": "python3 scripts/catalog-assets.py",
    "check:assets": "python3 scripts/catalog-assets.py --check",
    "prepare:catalog": "python3 scripts/catalog_metadata.py && python3 scripts/catalog-assets.py",
    "generate:catalog": "python3 scripts/catalog.py",
    "check:catalog": "python3 scripts/catalog.py --check",
    "format": "prettier --write \"**/*.{md,html,mjml,json,yml,css,scss,ts,tsx,js,jsx}\"",
    "lint": "eslint '**/*.{ts,tsx}'",
    "lint:fix": "eslint '**/*.{ts,tsx}' --fix",
    "test:jest": "pnpm exec jest --passWithNoTests",
    "test:watch": "pnpm exec jest --watchAll --verbose"
  },
